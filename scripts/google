#!/usr/bin/env python3
"""CLI for googlesearch.

When installed via `make install`, %ROOT% is replaced with the
absolute path to the checkout so the module is always importable.
"""

import sys
import os

_root = "%ROOT%"
if _root.startswith("%ROOT"):  # not substituted — running from checkout
    _root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

if _root not in sys.path:
    sys.path.insert(0, _root)

from googlesearch.__main__ import main

sys.exit(main())
